{
  "comment": "Level-2 matched problems (docs/validation.md). Each block is a lindhard input (docs/cli.md) plus the metrics compared. An oracle adapter must reproduce the same physics choices from the oracle's own documented input options; where an oracle cannot, the adapter records the difference in the summary's 'mismatches' list. E_d, E_b and E_s are model parameters chosen for the comparison, not data.",
  "problems": [
    {
      "id": "b_5keV_si",
      "description": "B 5 keV into amorphous Si, normal incidence: range moments",
      "beam": { "ion": "B", "energy_ev": 5000.0, "tilt_deg": 0.0 },
      "target": { "substrate": "Si" },
      "physics": {
        "potential": "zbl",
        "stopping": "lindhard-scharff",
        "free_path": "constant",
        "primary_cutoff_ev": 5.0,
        "recoil_cutoff_ev": 2.0,
        "follow_recoils": false,
        "energies": { "Si": { "e_d_ev": 15.0, "e_b_ev": 0.0 } }
      },
      "run": { "ions": 20000, "seed": 1 },
      "tally": { "depth_bin_nm": 0.5, "depth_bins": 400 },
      "metrics": ["rp_nm", "drp_nm", "backscatter", "ions_per_s"]
    },
    {
      "id": "as_50keV_si",
      "description": "As 50 keV into amorphous Si, normal incidence: range moments",
      "beam": { "ion": "As", "energy_ev": 50000.0, "tilt_deg": 0.0 },
      "target": { "substrate": "Si" },
      "physics": {
        "potential": "zbl",
        "stopping": "lindhard-scharff",
        "free_path": "constant",
        "primary_cutoff_ev": 5.0,
        "recoil_cutoff_ev": 2.0,
        "follow_recoils": false,
        "energies": { "Si": { "e_d_ev": 15.0, "e_b_ev": 0.0 } }
      },
      "run": { "ions": 20000, "seed": 1 },
      "tally": { "depth_bin_nm": 0.5, "depth_bins": 400 },
      "metrics": ["rp_nm", "drp_nm", "backscatter", "ions_per_s"]
    },
    {
      "id": "ar_1keV_cu",
      "description": "Ar 1 keV onto Cu, normal incidence, full cascades: sputter yield and reflection",
      "beam": { "ion": "Ar", "energy_ev": 1000.0, "tilt_deg": 0.0 },
      "target": { "substrate": "Cu" },
      "physics": {
        "potential": "zbl",
        "stopping": "lindhard-scharff",
        "free_path": "constant",
        "primary_cutoff_ev": 2.0,
        "recoil_cutoff_ev": 1.0,
        "follow_recoils": true,
        "energies": { "Cu": { "e_b_ev": 0.0 } }
      },
      "run": { "ions": 20000, "seed": 1 },
      "tally": { "depth_bin_nm": 0.1, "depth_bins": 100 },
      "metrics": ["sputter_yield", "backscatter", "ions_per_s"]
    }
  ]
}
